rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 본인 계정(uid) 문서만 읽고 쓸 수 있다 — 다른 사람 프로필은 절대 조회/수정 불가.
    // {document=**}까지 열어야 보관함 리포트 본문(users/{uid}/reports/{id})에도 같은 규칙이 적용된다.
    // Firestore 규칙은 하위 컬렉션으로 자동 상속되지 않아서, 이게 없으면 리포트 저장/조회가 전부 막힌다.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ═══ 냥(포인트) 시스템 — 관상냥반_냥시스템_기획서.md v2.0 ═══
    // wallets/nyangLedger/adminGrants는 users/{uid} 트리 밖의 최상위 컬렉션이다. 위 users 규칙은
    // "본인 문서면 뭐든 쓰기 허용"이라 만약 지갑을 users/{uid}/wallet 밑에 뒀다면 사용자가 devtools로
    // 자기 잔액을 직접 조작할 수 있었을 것 — 그래서 아예 다른 트리로 분리하고 write는 전부 막는다.
    // 잔액 변경(차감/지급)은 반드시 Cloud Function(Admin SDK, 이 규칙을 우회함)을 통해서만 일어난다.
    match /wallets/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /nyangLedger/{ledgerId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /adminGrants/{grantId} {
      // 기획서 스코프상 별도 조회 화면이 없음 — 필요하면 Firebase 콘솔에서 직접 조회.
      allow read, write: if false;
    }
    // 관리자 여부만 담는 별도 문서 — users/{uid}에 role 필드를 두면 "본인 문서 자유 쓰기" 규칙 때문에
    // 누구나 스스로 admin으로 바꿀 수 있어 여기로 분리했다. 이 문서 자체는 클라이언트가 절대 못 쓰고
    // (Firebase 콘솔에서 수동 생성/수정), 자기 것만 읽어서 "관리자 지급 화면을 보여줄지" 판단하는 용도.
    match /roles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // 삭제 이벤트 로그 — cleanupExpiredDogam(Admin SDK, 이 규칙을 우회)만 기록한다.
    // 개인정보는 담지 않지만 어떤 도감이 언제 사라졌는지 드러나므로 클라이언트는 읽지도 쓰지도 못한다.
    match /deletionLogs/{logId} {
      allow read, write: if false;
    }

    // ═══ 인연도감 — 공유 링크로 열리는 도감(공개 읽기) ═══
    // 링크를 받은 사람은 로그인 없이도 도감을 볼 수 있어야 해서 read는 공개다. slug가 추측 불가한
    // 랜덤 문자열이라 목록 조회 없이는 남의 도감을 찾을 수 없다(명세서 §2 크롤링 대응).
    // 저장하는 건 이름(별명)·캐릭터 ID·궁합 점수뿐 — 사진과 생년월일은 애초에 담지 않는다.
    match /dogam/{slug} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // 문서 id를 참여자 uid로 고정한다 — 남의 이름으로 등록하거나 남의 기록을 지우는 걸
      // 규칙 한 줄로 막을 수 있고, 같은 사람이 두 번 등록되는 것도 자연히 방지된다.
      match /entries/{entryUid} {
        allow read: if true;
        // 본인 등록이거나, 도감 주인이 상대를 자기 도감에 함께 올리는 경우(상호 등록)만 허용.
        allow create, update: if request.auth != null && (
                                (request.auth.uid == entryUid && request.resource.data.uid == entryUid) ||
                                get(/databases/$(database)/documents/dogam/$(slug)).data.ownerUid == request.auth.uid
                              );
        // 본인은 자기 기록을, 도감 주인은 자기 도감의 모든 기록을 지울 수 있다(명세서 §1.3).
        allow delete: if request.auth != null && (
                        request.auth.uid == entryUid ||
                        get(/databases/$(database)/documents/dogam/$(slug)).data.ownerUid == request.auth.uid
                      );
      }
    }
  }
}
