rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 본인 계정(uid) 문서만 읽고 쓸 수 있다 — 다른 사람 프로필은 절대 조회/수정 불가.
    // {document=**}까지 열어야 보관함 리포트 본문(users/{uid}/reports/{id})에도 같은 규칙이 적용된다.
    // Firestore 규칙은 하위 컬렉션으로 자동 상속되지 않아서, 이게 없으면 리포트 저장/조회가 전부 막힌다.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
